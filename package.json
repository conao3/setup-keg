{
  "name": "setup-keg",
  "version": "0.0.1",
  "private": true,
  "description": "Github Action to set up a specific Keg version",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts --minify",
    "watch": "ncc build src/main.ts --watch",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conao3/setup-keg.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "Naoya Yamashita",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/exec": "^2.0.0",
    "@actions/io": "^2.0.0",
    "@actions/tool-cache": "^3.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/semver": "^7.8.0",
    "@vercel/ncc": "^0.45.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-circus": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "ansi-regex": "^5.0.1",
    "js-yaml": "^3.15.2",
    "lodash": "^4.18.1",
    "picomatch": "^2.3.2",
    "semver": "^6.3.1"
  }
}
